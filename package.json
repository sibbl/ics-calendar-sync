{
  "name": "ics-google-calendar-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=junit --outputFile=reports/vitest.xml",
    "e2e": "playwright test",
    "start": "node dist-server/server/index.js",
    "once": "node dist-server/server/cli.js",
    "demo": "node dist-server/server/demo.js",
    "oauth:setup": "node dist-server/server/oauth-setup.js",
    "auth:migrate": "node dist-server/server/auth-migrate.js",
    "postinstall": "node scripts/patch-re2.cjs"
  },
  "dependencies": {
    "@hono/node-server": "https://registry.npmjs.org/@hono/node-server/-/node-server-1.19.9.tgz",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "croner": "10.0.1",
    "hono": "4.12.10",
    "lucide-react": "0.563.0",
    "luxon": "3.7.2",
    "re2-wasm": "1.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "safe-regex2": "5.0.0",
    "tailwind-merge": "3.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/luxon": "3.7.1",
    "@types/node": "24.10.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "27.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.27.7",
    "@rollup/rollup-darwin-arm64": "4.63.6",
    "@tailwindcss/oxide-darwin-arm64": "4.2.1",
    "lightningcss-darwin-arm64": "1.31.1"
  }
}
