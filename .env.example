# No real credentials. Node does not load this file automatically.
APP_ADMIN_TOKEN=
ENABLE_GOOGLE_WRITES=false
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Docker: host folder mounted read-only at /sources.
ICS_SOURCE_DIR=./ics
# Native CLI only: optionally set WATCH_ROOT to your local source folder.
PORT=8080
HOST=127.0.0.1
SOURCES_JSON=[{"id":"00000000-0000-4000-8000-000000000001","name":"Synthetic","kind":"file","location":"synthetic.ics","enabled":false,"rules":{"busyMode":"outlook_busy","excludeRegex":"^Mittagspause$","acceptedCount":false,"floatingTimezone":"Europe/Berlin"}}]

# Persistente Auswahl für dateibasiertes OAuth nach Einrichtung des geschützten Stores:
# COMPOSE_FILE=compose.yaml:compose.auth.yaml
# Dann reichen docker compose up -d und docker compose down ohne -f-Optionen.

# Optional snapshot approval / cleanup state (0700, owner matches container UID/GID):
# DATA_STATE_DIR=./data
# COMPOSE_FILE=compose.yaml:compose.auth.yaml:compose.data.yaml
# Add compose.consume.yaml only after explicitly enabling archive/delete.
